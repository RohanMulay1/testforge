# Copy to .env and fill in. Required for the agent + optimizer (anything that calls the SDK).
# The harness unit tests (pytest tests/) do NOT need this.
ANTHROPIC_API_KEY=

# Optional: pin the model used by both the test-writing agent and the optimizer agent.
# Held fixed across baseline/best so improvement is attributable to prompt+config, not a model swap.
TESTFORGE_MODEL=claude-sonnet-4-6
